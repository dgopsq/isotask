filters:
  and:
    - type == "task"
    - status != "done"
views:
  - type: isotask-feed
    name: Feed
    newItemFolder: Tasks
    order:
      - file.name
      - status
      - due
      - scheduled
      - priority
      - project
      - tags
  - type: isotask-calendar
    name: Calendar
    newItemFolder: Tasks
  - type: table
    name: All tasks
    order:
      - file.name
      - status
      - priority
      - due
      - scheduled

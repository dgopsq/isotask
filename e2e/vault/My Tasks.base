filters:
  and:
    - type == "task"
    - status != "done"
    - file.inFolder("DocsDemo")
views:
  - type: isotask-feed
    name: Feed
    newItemFolder: DocsDemo
    order:
      - file.name
      - status
      - due
      - scheduled
      - priority
      - project
      - tags
  - type: isotask-calendar
    name: Calendar
    newItemFolder: DocsDemo

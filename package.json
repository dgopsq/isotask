{
  "name": "obtask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notes as tasks: statuses, due dates, recurrence, feed and calendar views built on Obsidian Bases.",
  "author": "Diego Pasquali",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && tsx e2e/generate-fixtures.mts && wdio run wdio.conf.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "version": "node version-bump.mjs && git add manifest.json versions.json package.json",
    "dev:link": "node scripts/link-vault.mjs"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "@wdio/cli": "9.31.4",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.4",
    "@wdio/mocha-framework": "9.31.2",
    "builtin-modules": "5.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "mocha": "10.8.2",
    "obsidian": "1.13.1",
    "tslib": "2.8.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wdio-obsidian-reporter": "3.2.0",
    "wdio-obsidian-service": "3.2.0",
    "webdriverio": "9.31.4"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "valibot": "1.4.2"
  }
}

{
  "name": "obtask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notes as tasks: statuses, due dates, recurrence, feed and calendar views built on Obsidian Bases.",
  "author": "Diego Pasquali",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "version": "node version-bump.mjs && git add manifest.json versions.json package.json"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "builtin-modules": "5.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@event-calendar/core": "5.12.0",
    "date-fns": "4.4.0",
    "rrule": "2.8.1",
    "valibot": "1.4.2"
  }
}
